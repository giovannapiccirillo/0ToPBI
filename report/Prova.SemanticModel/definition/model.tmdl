model Model
	culture: it-IT
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: it-IT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["Vendite","Prodotti","Calendario"]

ref table Vendite
ref table Prodotti
ref table Calendario

ref cultureInfo it-IT
